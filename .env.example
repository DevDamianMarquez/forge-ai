# FORGE — environment variable placeholders
# No real values, endpoints, or credentials. Fill in locally; never commit a real .env.

# --- App ---
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Meta Model API (Muse Spark) ---
# SDK: OpenAI Python SDK (`from openai import OpenAI`), base URL
# https://api.meta.ai/v1, model muse-spark-1.3. The SDK does not read this
# automatically -- FORGE passes it explicitly (see app/services/meta_model.py).
# Never commit a real key here.
MODEL_API_KEY=

# "Muse Spark Open" is not integrated yet; no variable is added for it.

# --- Frontend ---
# See frontend/.env.example for the frontend's own copy of this.
NEXT_PUBLIC_FORGE_API_URL=http://localhost:8000

# --- CORS (backend) ---
# Comma-separated list of origins the FastAPI backend accepts browser
# requests from. Defaults to the local Next.js dev server if unset -- never
# a wildcard "*" in this project. See backend/app/main.py.
FORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
